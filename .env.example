# Copy this file to .env and fill in YOUR values. Never commit .env.

# --- MySQL -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghost_hunter
# Least-privilege account used by the web application (created by the setup script)
DB_APP_USER=ghost_app
DB_APP_PASSWORD=change-me-to-a-long-random-password
# Administrative account - used ONLY by backend/scripts/setup_database.py
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your-mysql-root-password

# --- Web application -------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
SESSION_HOURS=8
COOKIE_SECURE=false          # set true when served over HTTPS
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_MB=20
# STORAGE_DIR=C:\path\to\sql-ghost-hunter\storage   (default: ./storage)

# --- AI (optional local LLM via Ollama) ------------------------------
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60

# --- Anomaly detection -----------------------------------------------
ANALYSIS_LOOKBACK_DAYS=30
AUTO_ANALYSIS_MINUTES=10     # 0 = only run when clicked
